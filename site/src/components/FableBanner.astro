---
import { SHOW_FABLE_BANNER, FABLE_AVAILABLE, FABLE_BANNER, FABLE_CLIFF_DATE } from '../config';

/**
 * Fable-5 return banner (REL-GTM §1). Flag-gated: SHOW_FABLE_BANNER=false pulls it in one
 * line, and the string itself lives in config.ts. ALSO gated on the FABLE_AVAILABLE master
 * switch: if Fable is re-suspended the banner does not render, and flipping FABLE_AVAILABLE
 * back to true restores it — no string edit. Dismissible — the choice persists in
 * localStorage. Secondary to the hero: a ticker, not a headline. The copy is GTM-authored
 * verbatim; only `backtick` spans become mono.
 *
 * POST-JULY-7 SWAP (REL-GTM §5): after the FABLE_CLIFF_DATE passes, swap the FABLE_BANNER
 * import for FABLE_BANNER_POST_CLIFF (staged in config.ts). Do NOT flip early — it fires
 * only once Fable actually meters. The countdown below auto-hides once the date has passed.
 */
const showBanner = SHOW_FABLE_BANNER && FABLE_AVAILABLE;
const html = FABLE_BANNER.replace(
  /`([^`]+)`/g,
  '<code class="rounded bg-ink/8 px-1 py-[1px] font-mono text-[0.92em]">$1</code>',
);
---

{
  showBanner && (
    <aside data-fable-banner class="w-full border-b border-amber/30 bg-amber-light text-ink">
      <div class="mx-auto flex max-w-6xl items-center justify-center gap-3 px-5 py-2.5">
        <p class="text-center text-sm font-medium leading-snug">
          <span class="mr-1.5 rounded-full bg-amber/25 px-2 py-[1px] text-[11px] font-semibold uppercase tracking-wide text-amber-deep">
            Claude Fable 5 is back
          </span>
          <span set:html={html} />
          <span
            data-fable-countdown
            data-cliff={FABLE_CLIFF_DATE}
            hidden
            class="ml-1.5 whitespace-nowrap font-semibold text-amber-deep"
          >
            <span data-fable-countdown-days></span> until Fable moves to usage credits
          </span>
          <a
            href="/blog/claude-code-model-choice-by-cost"
            class="ml-1.5 whitespace-nowrap font-semibold underline underline-offset-2 hover:text-amber-deep"
            data-track="fable_banner_click"
          >
            How Fable billing works →
          </a>
        </p>
        <button
          type="button"
          data-fable-dismiss
          aria-label="Dismiss"
          class="shrink-0 rounded p-1 leading-none text-ink/50 transition hover:bg-ink/5 hover:text-ink"
        >
          ✕
        </button>
      </div>
    </aside>
  )
}

<script>
  function initFableBanner() {
    const el = document.querySelector<HTMLElement>('[data-fable-banner]');
    if (!el || el.dataset.init) return;
    el.dataset.init = '1';

    // Live countdown to the Fable allowance→credits cliff (REL-GTM §1). Whole days only;
    // the countdown auto-hides once the date has passed (it does NOT hide the banner).
    const cd = el.querySelector<HTMLElement>('[data-fable-countdown]');
    const cdDays = el.querySelector<HTMLElement>('[data-fable-countdown-days]');
    if (cd && cdDays) {
      const cliffStr = cd.dataset.cliff;
      const cliff = cliffStr ? new Date(`${cliffStr}T00:00:00-04:00`) : null;
      if (cliff && !Number.isNaN(cliff.getTime())) {
        const msPerDay = 24 * 60 * 60 * 1000;
        const days = Math.ceil((cliff.getTime() - Date.now()) / msPerDay);
        if (days > 0) {
          cdDays.textContent = `${days} day${days === 1 ? '' : 's'}`;
          cd.hidden = false;
        }
      }
    }

    const KEY = 'wt_fable_banner_dismissed';
    try {
      if (localStorage.getItem(KEY) === '1') {
        el.remove();
        return;
      }
    } catch {
      /* no-op */
    }
    el.querySelector('[data-fable-dismiss]')?.addEventListener('click', () => {
      el.remove();
      try {
        localStorage.setItem(KEY, '1');
      } catch {
        /* no-op */
      }
    });
  }
  initFableBanner();
  document.addEventListener('astro:page-load', initFableBanner);
</script>
