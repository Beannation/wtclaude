---
import BaseLayout from '../layouts/BaseLayout.astro';
import CodeBlock from '../components/CodeBlock.astro';
import HonestyBadge from '../components/HonestyBadge.astro';
import { SHOW_TASKS_FEATURE, GUARDIAN_PRICE, CLOUD_LIVE, SPLIT_LIVE } from '../config';
import { faqPage, breadcrumbs } from '../lib/schema';

const title = 'WTClaude docs — install & CLI reference';
const description =
  'Install WTClaude in 60 seconds and track your real Claude Code usage. Quick start, the full CLI command reference (v0.3.1), and FAQ.';

// CLI reference — organized by what you're doing. Every description + flag was
// verified against the shipped `wtclaude --help` (v0.3.1 — command set and flags
// diffed against 0.3.0 on 2026-09-27: identical; only two descriptions changed). Run
// `wtclaude <command> --help` for the authoritative flag list on your install.

// The Agent-SDK credit cluster (forecast / credits / readiness) was built for the
// June-15 Agent-SDK billing split, which Anthropic PAUSED before it took effect
// (SPLIT_LIVE=false). The commands still run; the copy stays honest about the pause.
const forecastingExtra = [
  {
    name: 'forecast',
    badge: 'estimate' as const,
    desc: SPLIT_LIVE
      ? 'projected Agent-SDK credit spend vs your included credits, with a countdown. `--days <n>`, `--json`.'
      : 'projected Agent-SDK credit spend vs your included credits. (The June-15 credit split it was built for was paused — this stays ready if a revised split lands.) `--days <n>`, `--json`.',
  },
  {
    name: 'credits',
    badge: 'estimate' as const,
    desc: 'your Agent-SDK + fast-mode credit balance and burn. `--json`.',
  },
  {
    name: 'readiness',
    badge: 'estimate' as const,
    desc: 'a one-time credit-coverage check (built for the June-14 readiness window; the split was paused, so it reads as ready). `--json`.',
  },
];

const cloudCommands = CLOUD_LIVE
  ? [
      {
        name: 'sync',
        desc: 'opt-in cloud backup + multi-device totals. `--status` / `--enable` / `--disable`. Local-first — nothing leaves your machine until you enable it, and you preview exactly what would sync before it does.',
      },
      {
        name: 'dashboard',
        desc: 'open the web dashboard in your browser — everything the CLI tracks, in one view.',
      },
    ]
  : [];

const sections = [
  {
    title: 'Everyday cost views',
    blurb: 'Your real spend, read from the statusline behind your bill.',
    commands: [
      {
        name: 'today · week · month',
        badge: 'billing-grade' as const,
        desc: 'real cost, tokens, and model breakdown for the day / last 7 / last 30 days. Flags: `--json`, `--csv`, `--clipboard`, `--since`/`--until`, `--group-by <project|branch|cost_center|task>`, `--currency <ISO>`.',
      },
      {
        name: 'compare',
        badge: 'billing-grade' as const,
        desc: 'the reveal — your billing-grade cost next to the session-log estimate, and the gap. `--days <n>` widens the window; `--share` saves a shareable card to `~/Desktop`.',
      },
      {
        name: 'report',
        badge: 'billing-grade' as const,
        desc: 'a monthly cost report. `--month <YYYY-MM>` picks the month; `--cost-center` breaks it down by cost center.',
      },
      {
        name: 'session [id]',
        badge: 'billing-grade' as const,
        desc: 'list sessions (newest first), or per-turn detail for one id. Supports `--json`, `--group-by`, `--csv`, `--clipboard`.',
      },
      {
        name: 'project [hash]',
        badge: 'billing-grade' as const,
        desc: 'usage for one project (by hash), or a list of known projects. Supports `--since`/`--until`, `--json`, `--csv`.',
      },
      {
        name: 'blocks',
        badge: 'billing-grade' as const,
        desc: 'usage bucketed into the rolling 5-hour windows your subscription limit resets on, so you can pace against it. `--limit <n>` caps how many show.',
      },
      {
        name: 'limit',
        badge: 'billing-grade' as const,
        desc: '**your overall plan limit** — % used + reset countdown, from Anthropic’s shared rate-limit bucket (it spans Code, Cowork, and Chat), so it’s your overall plan limit, not a Code-only number.',
      },
      {
        name: 'watch',
        desc: 'a live terminal monitor: today’s cost, current 5h-block burn, and the plan-limit gauge with a basic, **non-predictive** time-to-limit. `--once` renders one frame; `--interval <s>` sets the refresh.',
      },
    ],
  },
  {
    title: 'Models & forecasting',
    blurb: 'What your usage would cost on each model — every projection a labeled estimate.',
    commands: [
      {
        name: 'compare-models',
        badge: 'estimate' as const,
        desc: '**new** — re-prices your recorded usage across **Opus 5.5**, **Sonnet 5**, and **Fable 5.1**: what would this month cost on each? Split by surface (Code billing-grade · Cowork a labeled estimate · Chat excluded). It re-prices your *recorded* usage, not the same task run on each model. Free. `--days <n>`, `--json`.',
      },
      {
        name: 'whatif',
        badge: 'estimate' as const,
        desc: 'quick plan- and model-comparison math on your recent usage. Flags: `--plan <pro|max5|max20>`, `--model <haiku|sonnet|opus>`, `--days <n>`.',
      },
      {
        name: 'fable',
        badge: 'estimate' as const,
        desc: 'reads your billing-grade Fable cost in the terminal and forecasts your pace at Fable list rates. Covers **Fable 5.1** (Claude Code’s default Fable model since v2.1.257) and **Fable 5**. Fable is permanent and plan-conditional: on **Max / Team Premium / Enterprise Premium** it’s included up to 50% of your **weekly usage limit** (a share of that limit, not an allowance on top of it, and not a credits wallet); on **Pro / Team Standard** it bills **usage credits** from the first token, at $10/$50 — cache-read is **$0.25 on Fable 5.1** and **$1 on Fable 5**, the one price that separates them. A labeled estimate — at standard API list rates; bundle discounts up to 30% and promos not reflected. `--days <n>`, `--plan <plan>`, `--json`.',
      },
      ...forecastingExtra,
    ],
    note: '**Opus 5.5** is Claude Code’s default model since v2.1.280 (`claude-opus-5-5`). WTClaude prices it correctly — $4/$20, with cache reads at $0.20 per million, off the model’s own reported tokens, with no unknown-model gaps. **Sonnet 5** stays at $2/$10 — the increase to $3/$15 once scheduled for September 1, 2026 was cancelled.',
  },
  {
    title: 'Insights',
    blurb: 'Beyond the dollars — where your context and effort actually go.',
    commands: [
      {
        name: 'waste',
        desc: '**new** — reveals the always-loaded skills and rules you never invoke, and what re-reading them costs, computed at **billing-grade cache-read rates** (each item’s token size is a labeled estimate). A read-only reveal: it recommends a **REVIEW**, never removes or changes anything. `--days <n>`, `--all`, `--json`.',
      },
      {
        name: 'quality',
        desc: 'your one-shot success rate — edits the model landed without a retry (file-aware, salted). Supports `--since`/`--until`, `--json`, `--csv`.',
      },
      { name: 'debrief', desc: 'an end-of-day summary — your costliest turn and a tip.' },
      {
        name: 'tasks',
        comingSoon: !SHOW_TASKS_FEATURE,
        desc: SHOW_TASKS_FEATURE
          ? 'token/cost breakdown by task category.'
          : 'token/cost breakdown by task category — coming soon (the live payload doesn’t expose tool names yet, so categories aren’t populated).',
      },
      { name: 'badges', desc: 'the usage badges you’ve earned.' },
      {
        name: 'leaderboard',
        desc: 'your local leaderboard standing, plus a privacy preview of exactly what a share would expose. `--json`.',
      },
    ],
  },
  {
    title: 'Sync & dashboard',
    blurb: 'Opt-in and local-first — nothing leaves your machine until you turn it on.',
    commands: [
      ...cloudCommands,
      {
        name: 'devices',
        desc: 'combined + per-device totals (rides cloud sync; with sync off it’s a local-only view of this machine, plus a hint to enable sync).',
      },
      {
        name: 'share',
        desc: 'manage anonymous data sharing for the leaderboard + benchmarks. `--preview` shows exactly what would be shared; `--enable` / `--disable`.',
      },
      { name: 'invite', desc: 'generate a shareable invite link.' },
    ],
  },
  {
    title: 'Setup & utility',
    blurb: '',
    commands: [
      {
        name: 'setup',
        desc: 'configure WTClaude — wires the Claude Code statusline and creates your local data dir; reads the credential Claude already wrote (no login). `--plan <pro|max5|max20>`, `--yes` for non-interactive.',
      },
      {
        name: 'export',
        desc: 'dump all local WTClaude data to JSON — everything stored about you. `--out <file>`, `--pretty`.',
      },
      {
        name: 'uninstall',
        desc: 'remove the WTClaude statusline hook. `--keep-data` leaves your local data; `--purge` also deletes `~/.wtclaude/`.',
      },
      {
        name: 'statusline',
        desc: 'render the WTClaude status line from your latest turn — a preview of what the collector prints back into Claude Code.',
      },
    ],
  },
];

const faqs = [
  {
    q: 'Is it accurate?',
    a: 'For Claude Code, yes — billing-grade. We read the statusline path, the same source behind your bill (Anthropic-computed, not a guarantee of your invoice). Forward-looking projections — the forecast, the Fable forecast, the cross-model comparison — are clearly-labeled estimates.',
  },
  {
    q: 'Does it track Cowork or Chat?',
    a: 'Terminal Code is the billing-grade surface. `compare-models` also shows a Cowork row as a labeled estimate where its data is present, and excludes Chat (no local cost data) rather than showing a fake zero. Fuller Cowork/Chat coverage is on the roadmap, always clearly labeled.',
  },
  {
    q: 'Does it work with the Claude desktop app?',
    a: 'Tracking requires the Claude Code CLI in your terminal — the statusline WTClaude reads only fires there. The desktop app and Cowork don’t emit it, so install via the terminal. (Desktop/Cowork coverage is on the roadmap.)',
  },
  {
    q: 'Will it slow me down?',
    a: 'No. The collector runs in the background, fire-and-forget. You won’t notice it.',
  },
  {
    q: 'Is my data private?',
    a: 'Everything runs locally by default. Cloud sync is opt-in, with a preview before anything leaves your machine.',
  },
  {
    q: 'Is it free?',
    a: `Yes, and open-source (MIT). A paid Guardian intelligence layer is coming at ${GUARDIAN_PRICE.full}; the tracker stays free.`,
  },
  {
    q: 'Who’s behind it?',
    a: 'An independent project. Not affiliated with Anthropic.',
  },
];

// FAQPage (drives People-Also-Ask) + BreadcrumbList (§4A).
const jsonLd = [
  faqPage(faqs),
  breadcrumbs([
    { name: 'Home', path: '/' },
    { name: 'Docs', path: '/docs' },
  ]),
];

// Escape raw angle brackets FIRST so flag placeholders like `--interval <s>`,
// `--days <n>`, `<ISO>` render as literal text — not as HTML tags. (`<s>` is the
// strikethrough tag; leaving it raw struck through the whole page.) Then add the
// code/bold/italic markup, which is the only real HTML we inject.
const escHtml = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const mdToHtml = (s: string) =>
  escHtml(s)
    .replace(/`([^`]+)`/g, '<code class="rounded bg-ink/5 px-1 py-0.5 font-mono text-[13px]">$1</code>')
    .replace(/\*\*([^*]+)\*\*/g, '<strong class="font-semibold text-ink">$1</strong>')
    .replace(/\*([^*]+)\*/g, '<em>$1</em>');
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <div class="mx-auto max-w-3xl px-5 py-16">
    <!-- QUICK START -->
    <section>
      <h1 class="font-head text-4xl">Get started</h1>
      <ol class="mt-8 space-y-6">
        <li>
          <div class="flex items-baseline gap-3">
            <span class="font-head text-amber">1</span>
            <code class="font-mono text-sm font-semibold">npx wtclaude setup</code>
          </div>
          <p class="mt-2 pl-7 text-sm leading-relaxed text-ink/70">
            wires up the statusline so WTClaude reads billing-grade data; reads the credential Claude
            already wrote, so there’s no login.
          </p>
          <div class="mt-3 pl-7">
            <CodeBlock code="npx wtclaude setup" />
          </div>
        </li>
        <li>
          <div class="flex items-baseline gap-3">
            <span class="font-head text-amber">2</span>
            <code class="font-mono text-sm font-semibold">wtclaude today</code>
          </div>
          <p class="mt-2 pl-7 text-sm leading-relaxed text-ink/70">your real cost so far today.</p>
        </li>
        <li>
          <div class="flex items-baseline gap-3">
            <span class="font-head text-amber">3</span>
            <code class="font-mono text-sm font-semibold">wtclaude compare</code>
          </div>
          <p class="mt-2 pl-7 text-sm leading-relaxed text-ink/70">
            the reveal: your billing-grade number next to the broken-log number.
          </p>
        </li>
      </ol>
      <p class="mt-6 text-sm text-ink/60">
        Requirements: macOS or Linux, Node, and the <strong class="text-ink/80">Claude Code CLI in your terminal</strong>. Free, MIT-licensed.
      </p>
      <p class="mt-3 rounded-lg border border-ink/10 bg-amber-light/30 px-4 py-3 text-sm leading-relaxed text-ink/70">
        <strong class="font-semibold text-ink">New in v0.3.1:</strong> Claude Opus 5.5 — Claude Code’s
        default model — is priced at $4/$20, with cache reads at $0.20 per million tokens; Claude
        Fable 5.1 is priced, including its cache reads at $0.25 per million tokens — a quarter of
        Fable 5’s, on the same base rates.
        <code class="rounded bg-ink/5 px-1 py-0.5 font-mono text-[13px]">wtclaude compare-models</code> prices your usage across
        Opus 5.5 · Sonnet 5 · Fable 5.1, and
        <code class="rounded bg-ink/5 px-1 py-0.5 font-mono text-[13px]">wtclaude waste</code> finds the context you’re paying for
        but never using.
      </p>
      <p class="mt-3 rounded-lg border border-ink/10 bg-card px-4 py-3 text-sm leading-relaxed text-ink/70">
        WTClaude reads the statusline, which only the terminal CLI emits — the Claude desktop app and
        Cowork don’t run it. (Desktop/Cowork tracking comes later, as clearly-labeled estimates.)
      </p>
    </section>

    <!-- CLI REFERENCE -->
    <section class="mt-16">
      <h2 class="font-head text-2xl">CLI reference</h2>
      <p class="mt-2 text-sm leading-relaxed text-warm">
        Everything the shipped CLI (v0.3.1) runs — run
        <code class="rounded bg-ink/5 px-1 py-0.5 font-mono text-[13px]">wtclaude &lt;command&gt; --help</code> for the full flags on
        your install. <strong class="font-medium text-ink/75">Billing-grade</strong> = terminal Code, Anthropic-computed (not a
        guarantee of your invoice); everything else is a labeled estimate.
      </p>

      {
        sections.map((sec) => (
          <div class="mt-8">
            <h3 class="font-head text-lg text-ink">{sec.title}</h3>
            {sec.blurb && <p class="mt-1 text-sm text-ink/55">{sec.blurb}</p>}
            <dl class="mt-4 divide-y divide-ink/10 rounded-2xl border border-ink/10 bg-card">
              {sec.commands.map((cmd) => (
                <div class="px-5 py-4">
                  <dt class="flex flex-wrap items-center gap-2">
                    <code class="font-mono text-sm font-semibold text-ink">{cmd.name}</code>
                    {'badge' in cmd && cmd.badge && <HonestyBadge kind={cmd.badge} />}
                    {'comingSoon' in cmd && cmd.comingSoon && (
                      <span class="rounded-full bg-ink/5 px-2 py-[2px] text-[11px] font-medium uppercase text-warm">coming soon</span>
                    )}
                  </dt>
                  <dd class="mt-1.5 text-sm leading-relaxed text-ink/70" set:html={mdToHtml(cmd.desc)} />
                </div>
              ))}
            </dl>
            {sec.note && (
              <p
                class="mt-3 rounded-lg border border-ink/10 bg-amber-light/30 px-4 py-3 text-sm leading-relaxed text-ink/70"
                set:html={mdToHtml(sec.note)}
              />
            )}
          </div>
        ))
      }

      <p class="mt-8 text-sm leading-relaxed text-ink/60">
        <strong class="font-medium text-ink/75">Global flags:</strong>
        <code class="rounded bg-ink/5 px-1 py-0.5 font-mono text-[13px]">--json</code> and
        <code class="rounded bg-ink/5 px-1 py-0.5 font-mono text-[13px]">--csv</code>/<code class="rounded bg-ink/5 px-1 py-0.5 font-mono text-[13px]">--clipboard</code>
        on the summary/report commands, and <code class="rounded bg-ink/5 px-1 py-0.5 font-mono text-[13px]">--currency=&lt;ISO&gt;</code>
        for display-only conversion (USD stays the billing-grade source).
      </p>
    </section>

    <!-- FAQ -->
    <section class="mt-16">
      <h2 class="font-head text-2xl">FAQ</h2>
      <div class="mt-6 space-y-3">
        {
          faqs.map((f) => (
            <details class="group rounded-xl border border-ink/10 bg-card px-5 py-4">
              <summary class="flex cursor-pointer items-center justify-between font-medium text-ink marker:content-['']">
                {f.q}
                <span class="ml-4 text-warm transition group-open:rotate-45">+</span>
              </summary>
              <p class="mt-3 text-sm leading-relaxed text-ink/70">{f.a}</p>
            </details>
          ))
        }
      </div>
    </section>
  </div>
</BaseLayout>
